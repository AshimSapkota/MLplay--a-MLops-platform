# --- MLflow ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- Ollama (LLM chat panel) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2:latest

# --- Remote GPU (AWS) config — only needed if you use compute_target=remote_gpu ---
AWS_REGION=us-east-1
GPU_AMI_ID=ami-xxxxxxxxxxxxxxxxx
GPU_INSTANCE_TYPE=g4dn.xlarge
GPU_KEY_NAME=training-gpu-key
GPU_KEY_PATH=/home/you/.ssh/training-gpu-key.pem
GPU_SECURITY_GROUP=training-gpu-sg
REMOTE_MLFLOW_URI=https://your-ngrok-url.ngrok-free.dev

# --- AWS credentials ---
# Prefer `aws configure` (stores creds in ~/.aws/credentials) over putting keys
# here. Only uncomment these if you specifically need boto3 to use this .env
# instead of your AWS CLI profile:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
